set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR mips64)
set(N64 ON)
if(DEFINED ENV{N64_INST})
  set(N64_INST $ENV{N64_INST})
else()
  set(N64_INST /opt/libdragon)
endif()
set(CMAKE_C_COMPILER ${N64_INST}/bin/mips64-elf-gcc)
set(CMAKE_CXX_COMPILER ${N64_INST}/bin/mips64-elf-g++)
set(CMAKE_AR ${N64_INST}/bin/mips64-elf-gcc-ar)
set(CMAKE_RANLIB ${N64_INST}/bin/mips64-elf-gcc-ranlib)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(_f "-march=vr4300 -mtune=vr4300 -mabi=o64 -I${N64_INST}/mips64-elf/include/newlib_overrides -I${N64_INST}/mips64-elf/include -include ktls.h -DN64 -DLIBDRAGON_PREVIEW=2 -falign-functions=32 -ffunction-sections -fdata-sections")
set(CMAKE_C_FLAGS_INIT "${_f}")
set(CMAKE_CXX_FLAGS_INIT "${_f} -include climits")
set(CMAKE_FIND_ROOT_PATH ${N64_INST}/mips64-elf)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${N64_INST}/mips64-elf/lib -Wl,-T,n64.ld -Wl,--gc-sections -Wl,--wrap,__do_global_ctors -Wl,-Map=devilutionx.map -flto-partition=one -Wl,--wrap=malloc -Wl,--wrap=realloc -Wl,--wrap=abort -Wl,--wrap=__assert_func -Wl,--wrap=fread -Wl,--wrap=debug_assert_func_f -Wl,--wrap=fopen -Wl,--wrap=cart_card_rd_dram")
set(CMAKE_CXX_STANDARD_LIBRARIES "-Wl,--start-group -ldragon -lc -lm -ldragonsys -lstdc++ -Wl,--end-group")
set(CMAKE_C_STANDARD_LIBRARIES "-Wl,--start-group -ldragon -lc -lm -ldragonsys -Wl,--end-group")
